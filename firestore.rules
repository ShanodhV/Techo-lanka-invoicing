// Firebase Firestore Security Rules for Techo Lanka CCTV Management System
// These rules secure your database while allowing proper functionality

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for user authentication and roles
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAdminOrFirstUser() {
      // Allow first user creation or existing admin
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function isValidUser() {
      return isAuthenticated();
      // Note: We'll check user document existence where needed, but not block all operations
    }
    
    function hasUserDocument() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Validate required fields for different document types
    function hasValidProductFields() {
      return request.resource.data.keys().hasAll(['name', 'category', 'price', 'stock', 'createdAt', 'updatedAt']) &&
             request.resource.data.name is string &&
             request.resource.data.category is string &&
             request.resource.data.price is number &&
             request.resource.data.stock is number &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp;
    }
    
    function hasValidCustomerFields() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'createdAt', 'updatedAt']) &&
             request.resource.data.name is string &&
             request.resource.data.phone is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp &&
             (request.resource.data.email == null || request.resource.data.email is string) &&
             (request.resource.data.address == null || request.resource.data.address is map) &&
             (request.resource.data.company == null || request.resource.data.company is string);
    }
    
    function hasValidQuotationFields() {
      return request.resource.data.keys().hasAll(['quotationNumber', 'customerId', 'items', 'subtotal', 'tax', 'total', 'status', 'createdAt', 'updatedAt']) &&
             request.resource.data.quotationNumber is string &&
             request.resource.data.customerId is string &&
             request.resource.data.items is list &&
             request.resource.data.subtotal is number &&
             request.resource.data.tax is number &&
             request.resource.data.total is number &&
             request.resource.data.status is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp;
    }
    
    function hasValidInvoiceFields() {
      return request.resource.data.keys().hasAll(['invoiceNumber', 'customerId', 'items', 'subtotal', 'tax', 'total', 'status', 'createdAt', 'updatedAt']) &&
             request.resource.data.invoiceNumber is string &&
             request.resource.data.customerId is string &&
             request.resource.data.items is list &&
             request.resource.data.subtotal is number &&
             request.resource.data.tax is number &&
             request.resource.data.total is number &&
             request.resource.data.status is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp;
    }
    
    function hasValidUserFields() {
      return request.resource.data.keys().hasAll(['email', 'role', 'displayName', 'createdAt', 'updatedAt']) &&
             request.resource.data.email is string &&
             request.resource.data.role in ['admin', 'staff'] &&
             request.resource.data.displayName is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp;
    }

    function hasValidUserCreationFields() {
      let requiredFields = ['uid', 'email', 'role', 'displayName', 'createdAt', 'updatedAt'];
      let validTypes = request.resource.data.uid is string &&
                      request.resource.data.email is string &&
                      request.resource.data.role in ['admin', 'staff'] &&
                      request.resource.data.displayName is string &&
                      request.resource.data.createdAt is timestamp &&
                      request.resource.data.updatedAt is timestamp;
      
      // Allow additional fields for user creation by admins
      return request.resource.data.keys().hasAll(requiredFields) && validTypes;
    }
    
    // Users collection - Only admins can read all users, users can read/update their own profile
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdminOrFirstUser() && hasValidUserCreationFields();
      allow update: if isAdmin() || (isOwner(userId) && hasValidUserFields());
    }
    
    // Products collection - Authenticated users can read, only admins can write
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && hasValidProductFields();
      allow update: if isAdmin() && hasValidProductFields();
      allow delete: if isAdmin();
    }
    
    // Customers collection - Authenticated users can read/write
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasValidCustomerFields();
      allow update: if isAuthenticated() && hasValidCustomerFields();
      allow delete: if isAdmin(); // Only admins can delete customers
    }
    
    // Quotations collection - Authenticated users can read/write
    match /quotations/{quotationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasValidQuotationFields();
      allow update: if isAuthenticated() && hasValidQuotationFields();
      allow delete: if isAdmin();
    }
    
    // Invoices collection - Authenticated users can read/write, with restrictions
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasValidInvoiceFields();
      // Allow updates for payment status and admin updates
      allow update: if isAuthenticated() && (
        (hasValidInvoiceFields() && isAdmin()) ||
        (request.writeFields.hasOnly(['paymentStatus', 'paidAmount', 'dueAmount', 'updatedAt']) && 
         resource.data.status != 'paid')
      );
      allow delete: if isAdmin();
    }
    
    // Inventory collection - For stock tracking
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Activities collection - For audit trail
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.timestamp is timestamp;
      allow update, delete: if isAdmin();
    }
    
    // User sessions collection - Users can only access their own sessions
    match /userSessions/{sessionId} {
      allow read, write: if isAuthenticated() && 
                        request.auth.uid == resource.data.userId;
    }
    
    // System settings - Only admins can read/write
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Activity logs - Authenticated users can create, only admins can read
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.timestamp is timestamp;
    }
    
    // Deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
