// Production-Ready Firestore Security Rules for Techo Lanka CCTV Management System
// Project ID: techolanka-1ec06
// These rules provide enterprise-grade security with proper role-based access control

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    
    // Authentication helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserId() {
      return request.auth.uid;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Role-based access control
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isValidUser() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'user'];
    }
    
    function isModerator() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }
    
    // ===== FIELD VALIDATION FUNCTIONS =====
    
    function hasValidUserFields() {
      let required = ['email', 'role', 'name', 'lastActivity', 'createdAt'];
      let validRoles = ['admin', 'user', 'moderator'];
      
      return request.resource.data.keys().hasAll(required) &&
             request.resource.data.email is string &&
             request.resource.data.role in validRoles &&
             request.resource.data.name is string &&
             request.resource.data.lastActivity is timestamp &&
             request.resource.data.createdAt is timestamp;
    }
    
    function hasValidProductFields() {
      let required = ['name', 'category', 'price', 'stock', 'createdAt', 'updatedAt', 'createdBy'];
      
      return request.resource.data.keys().hasAll(required) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.category is string &&
             request.resource.data.price is number &&
             request.resource.data.price >= 0 &&
             request.resource.data.stock is number &&
             request.resource.data.stock >= 0 &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.createdBy is string;
    }
    
    function hasValidCustomerFields() {
      let required = ['name', 'email', 'phone', 'address', 'createdAt', 'updatedAt', 'createdBy'];
      
      return request.resource.data.keys().hasAll(required) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.email is string &&
             request.resource.data.email.matches('.*@.*\\..*') &&
             request.resource.data.phone is string &&
             request.resource.data.address is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.createdBy is string;
    }
    
    function hasValidQuotationFields() {
      let required = ['quotationNumber', 'customerId', 'customerName', 'items', 'subtotal', 'tax', 'total', 'status', 'validUntil', 'createdAt', 'updatedAt', 'createdBy'];
      let validStatuses = ['draft', 'sent', 'accepted', 'rejected', 'expired', 'converted'];
      
      return request.resource.data.keys().hasAll(required) &&
             request.resource.data.quotationNumber is string &&
             request.resource.data.quotationNumber.matches('^QUO-[0-9]{4}-[0-9]{4}$') &&
             request.resource.data.customerId is string &&
             request.resource.data.customerName is string &&
             request.resource.data.items is list &&
             request.resource.data.items.size() > 0 &&
             request.resource.data.subtotal is number &&
             request.resource.data.subtotal >= 0 &&
             request.resource.data.tax is number &&
             request.resource.data.tax >= 0 &&
             request.resource.data.total is number &&
             request.resource.data.total >= 0 &&
             request.resource.data.status in validStatuses &&
             request.resource.data.validUntil is timestamp &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.createdBy is string;
    }
    
    function hasValidInvoiceFields() {
      let required = ['invoiceNumber', 'customerId', 'customerName', 'items', 'subtotal', 'tax', 'total', 'status', 'paymentStatus', 'dueDate', 'createdAt', 'updatedAt', 'createdBy'];
      let validStatuses = ['draft', 'sent', 'paid', 'overdue', 'cancelled'];
      let validPaymentStatuses = ['pending', 'partial', 'paid', 'overdue'];
      
      return request.resource.data.keys().hasAll(required) &&
             request.resource.data.invoiceNumber is string &&
             request.resource.data.invoiceNumber.matches('^INV-[0-9]{4}-[0-9]{4}$') &&
             request.resource.data.customerId is string &&
             request.resource.data.customerName is string &&
             request.resource.data.items is list &&
             request.resource.data.items.size() > 0 &&
             request.resource.data.subtotal is number &&
             request.resource.data.subtotal >= 0 &&
             request.resource.data.tax is number &&
             request.resource.data.tax >= 0 &&
             request.resource.data.total is number &&
             request.resource.data.total >= 0 &&
             request.resource.data.status in validStatuses &&
             request.resource.data.paymentStatus in validPaymentStatuses &&
             request.resource.data.dueDate is timestamp &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.createdBy is string;
    }
    
    // ===== SECURITY RULES =====
    
    // Users collection - Role-based access with strict validation
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() && hasValidUserFields() && 
                   request.resource.data.createdBy == request.auth.uid;
      allow update: if (isAdmin() && hasValidUserFields()) || 
                   (isOwner(userId) && hasValidUserFields() && 
                    request.resource.data.role == resource.data.role); // Users can't change their own role
      allow delete: if isAdmin() && !isOwner(userId); // Admins can't delete themselves
    }
    
    // Products collection - Admin/Moderator write, authenticated read
    match /products/{productId} {
      allow read: if isValidUser();
      allow create: if isModerator() && hasValidProductFields() && 
                   request.resource.data.createdBy == request.auth.uid;
      allow update: if isModerator() && hasValidProductFields() &&
                   request.resource.data.createdBy == resource.data.createdBy; // Preserve original creator
      allow delete: if isAdmin();
    }
    
    // Customers collection - Authenticated users with validation
    match /customers/{customerId} {
      allow read: if isValidUser();
      allow create: if isValidUser() && hasValidCustomerFields() && 
                   request.resource.data.createdBy == request.auth.uid;
      allow update: if isValidUser() && hasValidCustomerFields() &&
                   request.resource.data.createdBy == resource.data.createdBy; // Preserve original creator
      allow delete: if isAdmin();
    }
    
    // Quotations collection - Business logic enforcement
    match /quotations/{quotationId} {
      allow read: if isValidUser();
      allow create: if isValidUser() && hasValidQuotationFields() && 
                   request.resource.data.createdBy == request.auth.uid;
      allow update: if isValidUser() && hasValidQuotationFields() && (
        // Creator can update if not converted to invoice
        (resource.data.createdBy == request.auth.uid && resource.data.status != 'converted') ||
        // Admins can always update
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Invoices collection - Strict business rules
    match /invoices/{invoiceId} {
      allow read: if isValidUser();
      allow create: if isValidUser() && hasValidInvoiceFields() && 
                   request.resource.data.createdBy == request.auth.uid;
      allow update: if isValidUser() && (
        // Admins can make any updates
        (isAdmin() && hasValidInvoiceFields()) ||
        // Users can only update payment-related fields for their own invoices
        (resource.data.createdBy == request.auth.uid && 
         request.writeFields.hasOnly(['paymentStatus', 'paidAmount', 'dueAmount', 'updatedAt', 'paymentDate', 'paymentNotes']) &&
         resource.data.status != 'cancelled')
      );
      allow delete: if isAdmin();
    }
    
    // Inventory tracking - Admin/Moderator only
    match /inventory/{inventoryId} {
      allow read: if isValidUser();
      allow write: if isModerator();
    }
    
    // Activity logs - Audit trail protection
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidUser() && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.timestamp is timestamp &&
                   request.resource.data.action is string &&
                   request.resource.data.details is map;
      allow update, delete: if false; // Activity logs are immutable
    }
    
    // User sessions - Personal access only
    match /userSessions/{sessionId} {
      allow read, write: if isAuthenticated() && 
                        request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // System settings - Admin only with validation
    match /settings/{settingId} {
      allow read: if isValidUser();
      allow write: if isAdmin() && 
                  request.resource.data.updatedBy == request.auth.uid &&
                  request.resource.data.updatedAt is timestamp;
    }
    
    // Company information - Moderators can update
    match /company/{docId} {
      allow read: if isValidUser();
      allow write: if isModerator();
    }
    
    // Reports and analytics - Role-based access
    match /reports/{reportId} {
      allow read: if isValidUser();
      allow write: if isModerator();
    }
    
    // Notifications - User-specific access
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && 
                        request.auth.uid == resource.data.userId;
    }
    
    // File uploads metadata - Authenticated users
    match /uploads/{uploadId} {
      allow read, write: if isValidUser() && 
                        request.auth.uid == resource.data.uploadedBy;
    }
    
    // Backup and system collections - Admin only
    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }
    
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // System logs should be written by server-side functions only
    }
    
    // Default deny rule - Security by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Storage Rules (for file uploads like product images, invoices, etc.)
service firebase.storage {
  match /b/{bucket}/o {
    // Product images - Moderators can upload, all authenticated users can read
    match /products/{productId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                  request.auth.uid == get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }
    
    // Invoice/Quotation PDFs - Users can upload their own documents
    match /documents/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Company assets - Moderators only
    match /company/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                  get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
